# Adyen API credentials
# Get these from Customer Area → Developers → API credentials
ADYEN_API_KEY=your-api-key-here
ADYEN_MERCHANT_ACCOUNT=your-merchant-account
ADYEN_CLIENT_KEY=your-client-key
ADYEN_ENVIRONMENT=test

# Flask session secret – change this to a random string in production
FLASK_SECRET_KEY=change-me-in-production
